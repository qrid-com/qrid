<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>qrs-sudo-askpass</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

	<!-- Display name -->
	<ApplicationTitle>Qrs Sudo AskPass BETA</ApplicationTitle>

	<!-- App Identifier -->
	<ApplicationId>com.qrid.qrs.app.sudoaskpass.cli.ca.sideloading</ApplicationId>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.5" />
	<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.5" />
	<PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.50.0" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Qrs.Client.Context\Qrs.Client.Context.csproj" />
		<ProjectReference Include="..\Qrs.Client\Qrs.Client.csproj" />
		<ProjectReference Include="..\Qrs.Proto\Qrs.Proto.csproj" />
	</ItemGroup>

</Project>
