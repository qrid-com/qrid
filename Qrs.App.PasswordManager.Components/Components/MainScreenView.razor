    private void MainDividerMouseDown(MouseEventArgs e)
    {
        State.MainDivider.IsDrag = true;
        State.MainDivider.StartX = Convert.ToInt32(e.PageX);
        State.MainDivider.StartWidth = State.LeftMenuWidth;

        

    }

    private void LayoutMouseMove2(MouseEventArgs e)
    {
        
    }

    private void LayoutMouseMove(MouseEventArgs e)
    {

        if (State.MainDivider.IsDrag)
        {
            // resizing LEFT MENU and COLUMNS AREA
            var newWidth = State.MainDivider.StartWidth + Convert.ToInt32(e.PageX) - State.MainDivider.StartX;

            LogInfo($"LayoutMouseMove(MAIN DIVIDER), old LeftMenuWidth={State.LeftMenuWidth}, newWith={newWidth})");

            //State.ColumnWidth = newWidth;
            //State.RenderHidden = true;

            App.DoSetMessageListWidth(newWidth);
            LogInfo($"LayoutMouseMove(MAIN LEFT DIVIDER), new LeftMenuWidth={State.LeftMenuWidth})");
        }

    }

    private void LayoutMouseUp(MouseEventArgs e)
    {
        State.MainDivider.IsDrag = false;
    }

    private void LayoutMouseLeave()
    {
        LayoutMouseUp(null);
    }





    public override void StateChangedCascade()
    {
        StateChanged();
        Vm.ListVm?.StateChangedCascade();
        Vm.DetailsVm?.StateChangedCascade();
