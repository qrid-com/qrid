@using Qrid.Common.Client.Misc
@using Qrs.App.PasswordManager.Client.Models;
@inherits Code.QridComponentBase


<MudPaper Elevation=0 Class="d-flex align-stretch flex-grow-1 gap-0" Style="height:100%;" >
    <MadSplitter @ref="_splitter" @bind-Dimension="@State.PersistentState.ListWidth"
                 EnableSlide="true" EnableMargin="false" Sensitivity="_sensitivity"
                 BarStyle="width:2px !important; background-color: #dee2e6 !important; margin-left: 8px; margin-right: 10px; margin-top:2px; margin-bottom: 2px;"
                 Height="100%"  Bordered="false">

        <StartContent>
            <div Class="pb-0 d-flex flex-1 mr-1" Style="@($"background:{Colors.BlueGray.Lighten5}; height:100%; overflow: hidden;")">
                <ListView ViewModel="Vm.ListVm" @ref="ListView" Parent=@this  />
            </div>
        </StartContent>

        <EndContent>
            <div Class="pb-0 d-flex flex-1 ml-2" Style="@($"background:{Colors.Gray.Lighten5}; height:100%;")">
                <DetailsView ViewModel="Vm.DetailsVm" @ref="DetailsView" Parent=@this />
            </div>
        </EndContent>

    </MadSplitter>
</MudPaper>

