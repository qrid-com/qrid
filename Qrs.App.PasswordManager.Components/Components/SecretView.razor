@using Qrid.Common.Crypto;
@using Qrs.App.PasswordManager.Client.Models;
@inherits Code.QridComponent<MainScreenView>
        
    @if (Vm.IsSecretOpen)
    {
        <MudPaper Width="100%" Elevation="0" Class="d-flex flex-row gap-2">

            <MudTextField Width="100%" Class="flex-grow-1 align-self-center " ReadOnly=@Vm.IsReadOnly
                Label="Password" AdornmentIcon="@Icons.Material.Filled.Password" Adornment="Adornment.End"  AdornmentColor="Color.Tertiary"
                OnAdornmentClick="GeneratePasswordClick"
                @bind-Text="@Vm.Password" T="string" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>

            <MudPaper Height="100%" Elevation="0" Class="align-self-center flex-grow-0 flex-1 ">
                <MudButton @onclick=HidePasswordClick
                            Variant="Variant.Outlined"
                            StartIcon="@Icons.Material.Filled.LockOpen"
                            Color="Color.Default"
                                           
                            >
                    <MudText>Hide</MudText>
                </MudButton>
            </MudPaper>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0">
        <MudTextField Label="Secret Notes" ReadOnly=@Vm.IsReadOnly
                @bind-Text="@Vm.SecretNotes"  T="string" Variant="Variant.Outlined" Lines="5" ></MudTextField>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0" Class="mt-4">
        <MudTextField Label="File Content" ReadOnly=true Disabled=true
                      @bind-Text="@Vm.FileContentMessage" T="string" Variant="Variant.Filled" Lines="2"></MudTextField>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0">
            <MudTextField Label="File Path" ReadOnly=@Vm.IsReadOnly
                          @bind-Text="@Vm.FilePath" T="string" Variant="Variant.Outlined" Lines="2"></MudTextField>

            <MudButton @onclick=ImportClick
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.FileOpen"
                       Color="Color.Default"
                   Disabled="@(Vm.IsReadOnly)"
                        Class="mt-2 mr-2">
                <MudText>Import</MudText>
            </MudButton>

            <MudButton @onclick=ExportClick
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Default"
                       Disabled="@(!Vm.IsFileContentAvailable)"
                        Class="mt-2">
                <MudText>Export</MudText>
            </MudButton>
        </MudPaper>

    }
    else
    {
        <MudPaper Width="100%" Elevation="0" Class="d-flex flex-row gap-2">

            <MudTextField Width="100%" Class="flex-grow-1 align-self-center " ReadOnly=true Disabled=true
                          Label="Password - HIDDEN" T="string" Variant="Variant.Filled" Margin="Margin.Dense"></MudTextField>

            <MudPaper Height="100%" Elevation="0" Class="align-self-center flex-grow-0 flex-1 ">
                <MudButton @onclick=ShowPasswordClick
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Lock"
                           Color="Color.Default">
                    <MudText>Show</MudText>
                </MudButton>
            </MudPaper>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0">
            <MudTextField Label="Secret Notes - HIDDEN" ReadOnly=true Disabled=true
            T="string" Variant="Variant.Filled" Lines="5"></MudTextField>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0" Class="mt-4">
            <MudTextField Label="File Content - HIDDEN" ReadOnly=true Disabled=true
                              T="string" Variant="Variant.Filled" Lines="2"></MudTextField>
        </MudPaper>

        <MudPaper Width="100%" Elevation="0">
            <MudTextField Label="File Path" ReadOnly=true Disabled=true
                          @bind-Text="@Vm.FilePath" T="string" Variant="Variant.Filled" Lines="2"></MudTextField>
        </MudPaper>


    }
    


@code {

    public SecretVm Vm => (SecretVm)ViewModel;


    protected override void OnInitialized()
    {
        Vm?.UpdateViewFromData();
    }

    private async Task ShowPasswordClick()
    {
        if (Vm?.DataModel == null) { return; }

        // try opening secret

        var res = await Context.ResourceOpenSecret(Context.Folder, Vm?.DataModel);

        if (res.IsError())
        {
            await App.ShowErrorAsync(res.Message);
            return;
        }

        // we've just successfully opened Secret

        // update UI
        Vm?.UpdateViewFromData();
    }

    private async Task HidePasswordClick()
    {
        // close secret and update UI

        Vm?.CloseSecret();
    }

    private async Task GeneratePasswordClick(MouseEventArgs args)
    {
        if (!Vm.IsReadOnly)
        {
            // generate random pwd of 20 chars
            Vm.Password = CryptoUtils.GetRandomPassword(20); 
        }
    }

    private async Task ImportClick()
    {
        if (Vm?.DataModel == null) { return; }

        // continue only if Secret is in Open state
        if (!Vm.IsSecretOpen)
        {
            // should NOT happen b/c button is not visible, but still
            await App.ShowErrorAsync("Please use 'Show' button to open the secret info first");
            return;
        }

        if (string.IsNullOrWhiteSpace(Vm.FilePath))
        {
            await App.ShowErrorAsync("Please provide a File Path");
            return;
        }

        if (Vm.FilePath.StartsWith(@""""))
        {
            Vm.FilePath = Vm.FilePath.Substring(1);
        }
        if (Vm.FilePath.EndsWith(@""""))
        {
            Vm.FilePath = Vm.FilePath.Substring(0, Vm.FilePath.Length - 1);
        }

        if (!File.Exists(Vm.FilePath))
        {
            await App.ShowErrorAsync("File does not exist");
            return;
        }

        // try opening file

        try
        {
            var bytes = File.ReadAllBytes(Vm.FilePath);
            Vm.FileContentSet(bytes);
            Vm.IsFileContentModified = true;
            Vm.IsFilePathModified = true;
        }
        catch (UnauthorizedAccessException uae)
        {
            await App.ShowErrorAsync($"Unauthorized Access - {uae.Message}");
            return;
        }
        catch (System.Security.SecurityException se)
        {
            await App.ShowErrorAsync($"Security Error - {se.Message}");
            return;
        }
        catch (Exception e)
        {
            await App.ShowErrorAsync($"Unexpected Error - {e.Message}");
            return;
        }

        await App.ShowMessageBoxAsync("SUCCESS", new MarkupString($"Imported from '{Vm.FilePath}'"));

        // update UI
        //Vm?.StateChanged();  -- no need b/c we are inside Event Handler
    }

    private async Task ExportClick()
    {
        if (Vm?.DataModel == null) { return; }

        // continue only if Secret is in Open state
        if (!Vm.IsSecretOpen)
        {
            // should NOT happen b/c button is not visible, but still
            await App.ShowErrorAsync("Please use 'Show' button to open the secret info first");
            return;
        }

        if (string.IsNullOrWhiteSpace(Vm.FilePath))
        {
            await App.ShowErrorAsync("Please provide a File Path");
            return;
        }

        if (Vm.FilePath.StartsWith(@""""))
        {
            Vm.FilePath = Vm.FilePath.Substring(1);
        }
        if (Vm.FilePath.EndsWith(@""""))
        {
            Vm.FilePath = Vm.FilePath.Substring(0, Vm.FilePath.Length - 1);
        }

        // Do NOT overwrite existing files !!!
        if (File.Exists(Vm.FilePath))
        {
            await App.ShowErrorAsync("File already exists! 'Export' button does NOT overwrite existing files");
            return;
        }

        // try writing to the new file

        try
        {
            File.WriteAllBytes(Vm.FilePath, Vm.FileContent);

        }
        catch (DirectoryNotFoundException dnfe)
        {
            await App.ShowErrorAsync($"Directory Not Found - {dnfe.Message}");
            return;
        }
        catch (UnauthorizedAccessException uae)
        {
            await App.ShowErrorAsync($"Unauthorized Access - {uae.Message}");
            return;
        }
        catch (System.Security.SecurityException se)
        {
            await App.ShowErrorAsync($"Security Error - {se.Message}");
            return;
        }
        catch (Exception e)
        {
            await App.ShowErrorAsync($"Unexpected Error - {e.Message}");
            return;
        }

        await App.ShowMessageBoxAsync("SUCCESS", new MarkupString($"Exported file content to '{Vm.FilePath}'"));
        
    }

}
