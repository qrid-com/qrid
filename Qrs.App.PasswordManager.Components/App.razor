@using Microsoft.AspNetCore.Components.Authorization
@inherits Code.QridComponentBase

<MudThemeProvider @ref="@MudThemeProvider" Theme="MyTheme" />
<MudPopoverProvider/>

<CascadingAuthenticationState @ref=authStateRef>

<Router AppAssembly="@typeof(Qrs.App.PasswordManager.Components.App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @{ App.NavigateToLogin(); }
                </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry ...................... there's nothing at this address. Rendering from COMPONENTS</p>
        </LayoutView>
    </NotFound>
</Router>

</CascadingAuthenticationState>

