<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Qrs.App.PasswordManager.Hybrid"
             xmlns:comp="clr-namespace:Qrs.App.PasswordManager.Components;assembly=Qrs.App.PasswordManager.Components"
             x:Class="Qrs.App.PasswordManager.Hybrid.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type comp:App}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>