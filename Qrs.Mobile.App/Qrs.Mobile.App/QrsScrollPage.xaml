<?xml version="1.0" encoding="utf-8" ?>
<q:QrsPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
               xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
               
               x:Class="Qrs.Mobile.App.QrsScrollPage"
               >

    <!-- Padding="20" Spacing="20" -->


    <Grid x:Name="RootGrid">
        <StackLayout>
        
            <ScrollView VerticalOptions="FillAndExpand">
                <StackLayout MinimumHeightRequest="800" x:Name="BodyView" />
            </ScrollView>

            

            <StackLayout x:Name="FooterView" VerticalOptions="End" IsVisible="False"/>
     
        </StackLayout>

        


    </Grid>

</q:QrsPageBase>