<?xml version="1.0" encoding="utf-8" ?>
<q:QrsScrollPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
             xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
             
             x:Class="Qrs.Mobile.App.Account.CreateBackup.CongratulationsPage"
               Title="Congratulations">
    <q:QrsScrollPage.Body>
        <StackLayout>

            <controls:TitleView Title="Congratulations!"/>

            <Label Style="{StaticResource ButtonInfo}" >
                Make sure you have saved that Backup Image! Whenever you re-install QRS app, manually or automatically upgrade your OS, you will need that Backup Image (and its Password) to load your Master Key into your phone. Do not lose that Image!
            </Label>

            <Button Text="Done!"  Clicked="Continue_Clicked"></Button>

        </StackLayout>
    </q:QrsScrollPage.Body>
</q:QrsScrollPage>