<?xml version="1.0" encoding="utf-8" ?>
<q:QrsScrollPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
             xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
             
             x:Class="Qrs.Mobile.App.Account.CreateBackup.BackupPasswordPage"
               Title="Backup Password">
    <q:QrsScrollPage.Body>
        <StackLayout>

            <controls:TitleView Title="Backup Password"/>
            <controls:TextInput x:Name="KeyName" LabelText="Key Name (read-only)" IsReadOnly="True"  ></controls:TextInput>
            <controls:TextInput x:Name="Password1" LabelText="Backup Password" IsPassword="true" ></controls:TextInput>
            <controls:TextInput x:Name="Password2" LabelText="Retype Password" IsPassword="true" ></controls:TextInput>
            
            <Button Text="Continue" Clicked="Continue_Clicked"></Button>
        </StackLayout>
    </q:QrsScrollPage.Body>
</q:QrsScrollPage>