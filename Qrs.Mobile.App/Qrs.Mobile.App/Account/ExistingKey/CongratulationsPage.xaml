<?xml version="1.0" encoding="utf-8" ?>
<q:QrsScrollPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
             xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
             
             x:Class="Qrs.Mobile.App.Account.ExistingKey.CongratulationsPage"
               Title="Congratulations!">
    <q:QrsScrollPage.Body>
        <StackLayout>

            <controls:TitleView x:Name="TitleView"  Title="Congratulations!"/>
            <Label Style="{StaticResource ButtonInfo}" >
                Master Key has been loaded from Backup Image and stored locally in your phone!
            </Label>
            <Button Text="Done!"  Clicked="Continue_Clicked"></Button>
            
        </StackLayout>
    </q:QrsScrollPage.Body>
</q:QrsScrollPage>