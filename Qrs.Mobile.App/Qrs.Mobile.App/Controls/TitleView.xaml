<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
             x:Class="Qrs.Mobile.App.Controls.TitleView"
             x:Name="this">
  <ContentView.Content>
        <StackLayout Spacing="0">
            <BoxView HeightRequest="32" BackgroundColor="{StaticResource Primary}" ></BoxView>
            <controls:PixelStripe></controls:PixelStripe>
          
            <Label 
              Text="{Binding Title, Source={x:Reference this}}" 
              Margin="18,30,18,2"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              VerticalTextAlignment="Center"
              HeightRequest="60"
              FontSize="Title">
          </Label>
      </StackLayout>
  </ContentView.Content>
</ContentView>