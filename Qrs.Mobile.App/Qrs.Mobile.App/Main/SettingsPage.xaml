<?xml version="1.0" encoding="utf-8" ?>
<q:QrsScrollPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
                 xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
                 
                 x:Class="Qrs.Mobile.App.Main.SettingsPage"
                 Title="Settings"
                 IsFooterVisible="False"
                 >
    <q:QrsScrollPage.Body>
        
        
        <StackLayout>

            <controls:TitleView Title="Settings"/>


            
            <Grid Margin="40,0,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <CheckBox x:Name="chkIgnoreValidation" Grid.Row="0" Grid.Column="0" Visual="Default"></CheckBox>
                <Label FontSize="17" TextColor="{StaticResource TextLight}" 
           Text="Ignore Validation Errors (for this session only)" 
           Grid.Row="0" Grid.Column="1" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Label1_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
                
                
                
            </Grid>


            <Button Text="Save"  Clicked="Continue_Clicked"></Button>



            <ContentView x:Name="vwDebugOnlyControls">
                <ContentView.Content>
                    <StackLayout>
                    
                    </StackLayout>
                </ContentView.Content>
            </ContentView>

        </StackLayout>

    
    </q:QrsScrollPage.Body>
    


</q:QrsScrollPage>