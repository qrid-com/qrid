<?xml version="1.0" encoding="utf-8" ?>
<q:QrsScrollPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                 xmlns:q="clr-namespace:Qrs.Mobile.App;assembly=Qrs.Mobile.App"
                 xmlns:controls="clr-namespace:Qrs.Mobile.App.Controls"
                 
                 x:Class="Qrs.Mobile.App.Main.MainPage"
                 Title="QRS"
                 IsFooterVisible="True"
                 >
    <q:QrsScrollPage.Body>
        
        
        <StackLayout>

            <controls:TitleView Title="QRS"/>

            <Label HorizontalOptions="Center" FontSize="22" Text="Loaded Keys:"/>

            <Button x:Name="BtnKey" 
                    BackgroundColor="#00000000" 
                    ImageSource="gold_key.png" 
                    Text="MasterKey"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    HeightRequest="70"
                    BorderColor="DarkGray"
                    Scale="1"
                    Padding="10,2"
                    Margin="18,16"
                    Clicked="BtnKey_Clicked"></Button>

            <Button BackgroundColor="#00000000" 
                    Text="Actions ..."
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    BorderColor="DarkGray"
                    Padding="18,2"
                    Margin="18,4"
                    CornerRadius="25"
                    Scale="1"
                    Clicked="Actions_Clicked"></Button>

            
            <controls:HowItWorks />
            
            <BoxView HeightRequest="100"></BoxView>

        </StackLayout>

    
    </q:QrsScrollPage.Body>
    
    <q:QrsScrollPage.Footer>
        <StackLayout HeightRequest="120">
            <Button Text="Scan" Clicked="Scan_Clicked" VerticalOptions="CenterAndExpand"></Button>
            <BoxView HeightRequest="15" ></BoxView>
        </StackLayout>
    </q:QrsScrollPage.Footer>

</q:QrsScrollPage>