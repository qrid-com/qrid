<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="150"
        x:Class="Qrs.UI.Avalonia.InputDialog"
        Title="Input"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <StackPanel Margin="15">
        <TextBlock x:Name="InputLabel" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>

</Window>
