<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="464" d:DesignHeight="516"
        x:Class="Qrs.UI.Avalonia.QrCodeWindow"
        Title="Scan with QRS mobile app"
        Width="464" Height="516"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="True">

    <DockPanel LastChildFill="True">

        <!-- Title -->
        <TextBlock x:Name="lblTitle"
                   DockPanel.Dock="Top"
                   Text="Scan with QRS mobile app"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,5"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <!-- Description -->
        <TextBlock x:Name="lblDescription"
                   DockPanel.Dock="Top"
                   Text="."
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,5"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <!-- Use QRS App label -->
        <TextBlock x:Name="lblUseQrsApp"
                   DockPanel.Dock="Top"
                   Text="Please use QRS mobile app to scan this QR code"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <!-- Bottom panel: Cancel button + Status -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,10">
            <Button x:Name="btnCancel"
                    Content="CANCEL"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Margin="0,5,0,5"
                    Click="btnCancel_Click" />
            <TextBlock x:Name="lnkStatus"
                       Text=""
                       FontSize="12"
                       HorizontalAlignment="Stretch"
                       Margin="0,5,0,0"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- QR Code Image (fills remaining space) -->
        <Border Margin="5" Background="White">
            <Image x:Name="picQrCode"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="None" />
        </Border>

    </DockPanel>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Copy QR Code Text" Click="copyQRCodeText_Click" />
        </ContextMenu>
    </Window.ContextMenu>

</Window>
