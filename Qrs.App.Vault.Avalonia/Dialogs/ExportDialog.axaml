<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="380"
        x:Class="Qrs.App.Vault.Avalonia.Dialogs.ExportDialog"
        Title="Export Selected Files"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

	<Grid Margin="15" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

		<TextBlock Grid.Row="0" x:Name="SummaryTextBlock" TextWrapping="Wrap" Margin="0,0,0,10"/>

		<!-- Export format -->
		<TextBlock Grid.Row="1" Text="Export format:" Margin="0,0,0,3"/>
		<ComboBox Grid.Row="2" x:Name="FormatComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,10"
				  SelectionChanged="FormatComboBox_SelectionChanged"/>

		<!-- Output path (zip file or gpg output folder) -->
		<TextBlock Grid.Row="3" x:Name="OutputLabel" Text="Zip file:" Margin="0,0,0,3"/>
		<Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
			<TextBox Grid.Column="0" x:Name="OutputPathTextBox"/>
			<Button Grid.Column="1" x:Name="BrowseButton" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
		</Grid>

		<!-- Password option -->
		<TextBlock Grid.Row="5" Text="Password:" Margin="0,0,0,3"/>
		<ComboBox Grid.Row="6" x:Name="PasswordOptionComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,10"
				  SelectionChanged="PasswordOptionComboBox_SelectionChanged"/>

		<!-- Password input (only for generate/manual) -->
		<StackPanel Grid.Row="7" x:Name="PasswordInputPanel" IsVisible="False">
			<TextBlock Text="Password:" Margin="0,0,0,3"/>
			<TextBox x:Name="PasswordTextBox" FontFamily="Consolas, Menlo, Monospace"/>
			<Label Classes="ButtonInfo" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
				This password will be stored inside the vault. Open the vault later to look it up.
			</Label>
		</StackPanel>

		<!-- Buttons -->
		<StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button x:Name="ExportButton" Content="Export" Margin="0,0,10,0" Click="Export_Click"/>
			<Button x:Name="CancelButton" Content="Cancel" Classes="Secondary" Click="Cancel_Click"/>
		</StackPanel>

	</Grid>

</Window>
