
<q:QrsViewBase xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:q="clr-namespace:Qrs.App.Vault.Avalonia;assembly=Qrs.App.Vault.Avalonia"
               xmlns:controls="clr-namespace:Qrs.App.Vault.Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"                
               x:Class="Qrs.App.Vault.Avalonia.Controls.QrPanel">
    <StackPanel Orientation="Vertical">

		<StackPanel.ContextMenu>
			<ContextMenu>
				<MenuItem Header="Copy QR CODE text" Click="OnCopyQrCodeClicked" />
				
			</ContextMenu>
		</StackPanel.ContextMenu>


        <controls:PanelHeader x:Name="Header" Title="Scan with QRS app" />

        <TextBlock
	          Text="Please use QRS mobile app to scan this QR code"
	          HorizontalAlignment="Center"
	          VerticalAlignment="Center"
	          TextAlignment="Center"
			  TextWrapping="Wrap"
	          />

		<ContentControl Width="250" Height="250" Margin="1,30,1,30">
			<Image x:Name="QrImage" HorizontalAlignment="Center" Height="250"/>
		</ContentControl>

        <Button Content="Cancel" HorizontalAlignment="Center" Click="Button_Cancel_Clicked"></Button>
        
    </StackPanel>
</q:QrsViewBase>
